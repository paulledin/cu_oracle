# Copy to secrets.toml (same folder) for local runs. NEVER commit secrets.toml.
# On Streamlit Community Cloud paste this content into App settings -> Secrets.

# ---------------------------------------------------------------------------
# User groups. The passphrase identifies the group; each must be unique.
# Every group gets the same Oracle.
# ---------------------------------------------------------------------------
[groups.acu_staff]
label = "America's Credit Unions staff"
password = "change-me-staff"

# ---------------------------------------------------------------------------
# Snowflake connection. Service account CU_ORACLE_APP_SVC / role
# CU_ORACLE_APP_READ (read-only + Cortex) - setup SQL lives in
# C:\Users\pledin\snowflake_utils\cu_oracle_app_svc_setup.sql.
# ---------------------------------------------------------------------------
[connections.snowflake]
account   = "CUNA-POLICYAZUREPROD"
user      = "CU_ORACLE_APP_SVC"
role      = "CU_ORACLE_APP_READ"
warehouse = "STREAMLIT_WH"
# RSA key-pair: the PUBLIC key is registered on the Snowflake user; paste the
# PRIVATE key here as a multi-line string (whole PEM, incl. BEGIN/END lines),
# or point private_key_path at a local file.
private_key = """-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"""
# private_key_passphrase = "..."          # only if the key is encrypted
#
# Local dev alternative: your own browser SSO instead of the service key -
# set user to your login, add authenticator = "externalbrowser", and omit
# the private_key lines.
